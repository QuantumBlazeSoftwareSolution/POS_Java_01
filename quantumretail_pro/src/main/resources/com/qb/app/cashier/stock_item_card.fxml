<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_LEFT" onMouseClicked="#handleMouseClick" spacing="10" style="-fx-background-radius: 12; -fx-border-width: 1; -fx-border-radius: 12; -fx-cursor: hand;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qb.app.controllers.cashier.Stock_item_cardController">

    <!-- Product Name Section -->
    <VBox spacing="4.0">
        <children>
            <Label text="Product" textFill="#919191">
                <font><Font size="11" /></font>
            </Label>
            <Label fx:id="nameLabel" text="Product Name" wrapText="true">
                <font><Font name="System Bold" size="15" /></font>
            </Label>
        </children>
    </VBox>
   <Separator prefWidth="200.0" />

    <!-- Parent Price -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <children>
            <Label text="Parent Price:" textFill="#919191">
                <font><Font size="12" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="priceLabel" text="0.00" textFill="#059669">
                <font><Font name="System Bold" size="13" /></font>
            </Label>
        </children>
    </HBox>

    <!-- Item Price -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <children>
            <Label text="Item Price:" textFill="#919191">
                <font><Font size="12" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="priceItem" text="0.00" textFill="#10B981">
                <font><Font name="System Bold" size="14" /></font>
            </Label>
        </children>
    </HBox>

    <!-- Expiry Date -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <children>
            <Label text="Expires:" textFill="#919191">
                <font><Font size="12" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="expLabel" style="-fx-background-color: #1e40af; -fx-background-radius: 6; -fx-padding: 4 8;" text="2026-01-05" textFill="WHITE">
                <font><Font name="System Bold" size="11" /></font>
            </Label>
        </children>
    </HBox>

    <padding>
        <Insets bottom="16" left="16" right="16" top="16" />
    </padding>

</VBox>
