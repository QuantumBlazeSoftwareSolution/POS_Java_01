<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="root" maxWidth="400.0" prefWidth="340.0" stylesheets="@../css/developerStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qb.app.controllers.developer.actionVerificationController">
   <children>
      <BorderPane maxHeight="-Infinity" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <HBox alignment="CENTER" prefHeight="40.0" prefWidth="200.0" styleClass="bg-primary" BorderPane.alignment="CENTER">
               <children>
                  <Label minWidth="-Infinity" styleClass="primary-white" stylesheets="@../css/style.css" text="Developer Action Verification">
                     <font>
                        <Font name="Segoe UI Bold" size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Label>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <StackPane onMouseClicked="#closeWindow" prefHeight="40.0" prefWidth="40.0" styleClass="titleBarIcon" stylesheets="@../css/style.css">
                     <children>
                        <Group fx:id="closeIcon" />
                     </children>
                  </StackPane>
               </children>
               <padding>
                  <Insets right="10.0" />
               </padding>
            </HBox>
         </top>
         <center>
            <HBox prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <VBox maxHeight="-Infinity" minWidth="-Infinity" spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox>
                           <children>
                              <Label styleClass="text-primary" text="Username">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="tfUsername" minHeight="40.0" prefHeight="40.0" prefWidth="250.0" stylesheets="@../css/style.css">
                                 <styleClass>
                                    <String fx:value="bg-white" />
                                    <String fx:value="primary-border" />
                                    <String fx:value="text-developer" />
                                 </styleClass>
                              </TextField>
                           </children>
                        </VBox>
                        <VBox layoutX="10.0" layoutY="10.0">
                           <children>
                              <Label styleClass="text-primary" text="Password">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <PasswordField fx:id="tfPassword" prefHeight="40.0" styleClass="text-developer" stylesheets="@../css/style.css" />
                           </children>
                        </VBox>
                        <VBox layoutX="10.0" layoutY="122.0">
                           <children>
                              <Label styleClass="text-primary" text="PIN">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <PasswordField fx:id="tfPin" prefHeight="40.0" styleClass="text-developer" stylesheets="@../css/style.css" />
                           </children>
                        </VBox>
                        <Button fx:id="btnAction" maxWidth="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#handlePinVerification" prefHeight="40.0" text="Proceed">
                           <padding>
                              <Insets left="25.0" right="25.0" />
                           </padding>
                           <font>
                              <Font name="Segoe UI Bold" size="14.0" />
                           </font>
                           <styleClass>
                              <String fx:value="bg-primary" />
                              <String fx:value="full-width-button" />
                              <String fx:value="primary-white" />
                              <String fx:value="scale-down-pressed" />
                           </styleClass>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
