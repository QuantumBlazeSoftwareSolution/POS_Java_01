                                    <Font name="Aptos" size="14.0" />
                                 </font>
                                 <styleClass>
                                    <String fx:value="full-width-button" />
                                    <String fx:value="primary-text" />
                                    <String fx:value="button-transparent" />
                                    <String fx:value="btn-white-hover" />
                                 </styleClass>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                                 <graphic>
                                    <Group fx:id="iconExit" />
                                 </graphic>
                              </Button>
