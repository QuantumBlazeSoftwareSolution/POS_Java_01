<AnchorPane id="AnchorPane" fx:id="root" prefHeight="440.0" prefWidth="720.0" styleClass="transparent-pane" stylesheets="@../css/adminStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qb.app.controllers.admin.AdminVerificationController">
   <children>
      <HBox prefHeight="400.0" prefWidth="720.0" styleClass="transparent-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Pane prefHeight="200.0" prefWidth="200.0" style="-fx-background-radius: 10; -fx-view-order: 1;" stylesheets="@../css/adminStyle.css" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" layoutX="53.0" layoutY="31.0" spacing="12.0">
                     <children>
                        <Circle fx:id="quantumBlazeIcon" fill="DODGERBLUE" radius="80.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                        <Label styleClass="primary-white" stylesheets="@../css/style.css" text="Welcome to Quantum Retail Pro">
                           <font>
                              <Font name="Aptos Black Italic" size="16.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" layoutX="15.0" layoutY="352.0" prefHeight="34.0" prefWidth="334.0">
                     <children>
                        <Label styleClass="primary-white-50" stylesheets="@../css/style.css" text="Developed by Quantum Blaze software solution">
                           <font>
                              <Font name="Aptos Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label styleClass="primary-white-50" stylesheets="@../css/style.css" text="Contact: 0788056838 | 0719892932">
                           <font>
                              <Font name="Aptos" size="12.0" />
                           </font></Label>
                     </children>
                  </VBox>
               </children>
               <styleClass>
                  <String fx:value="primary-gradient" />
                  <String fx:value="system-login-left-panel" />
               </styleClass>
               <effect>
                  <DropShadow />
               </effect>
            </Pane>
            <BorderPane prefHeight="200.0" prefWidth="200.0" style="-fx-view-order: 2;" HBox.hgrow="ALWAYS">
               <center>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" style="-fx-background-radius: 0 10 10 0;" styleClass="bg-white" stylesheets="@../css/style.css" BorderPane.alignment="CENTER">
                     <children>
                        <VBox alignment="CENTER" prefWidth="100.0" spacing="10.0">
                           <children>
                              <Group fx:id="iconAdmin" />
                              <Label styleClass="primary-text" stylesheets="@../css/style.css" text="Admin Verification">
                                 <font>
                                    <Font name="Aptos Black" size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" prefWidth="100.0" spacing="4.0">
                           <children>
                              <Label styleClass="primary-text" stylesheets="@../css/adminStyle.css" text="Pin Number">
                                 <font>
                                    <Font name="Aptos" size="14.0" />
                                 </font>
                              </Label>
                              <PasswordField fx:id="tfPinNumber" onKeyPressed="#handleKeyEvent" prefHeight="40.0" styleClass="primary-text" stylesheets="@../css/adminStyle.css" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" prefWidth="100.0" spacing="4.0">
                           <children>
                              <Button fx:id="btnVerify" mnemonicParsing="false" onAction="#handleSystemVerification" prefHeight="35.0" stylesheets="@../css/adminStyle.css" text="Verify">
                                 <styleClass>
                                    <String fx:value="full-width-button" />
                                    <String fx:value="button-gradient" />
                                    <String fx:value="primary-white" />
                                 </styleClass>
                                 <font>
                                    <Font name="Aptos" size="14.0" />
                                 </font>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                              </Button>
                              <Button fx:id="btnExit" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleSystemVerification" prefHeight="35.0" stylesheets="@../css/style.css" text="Exit">
