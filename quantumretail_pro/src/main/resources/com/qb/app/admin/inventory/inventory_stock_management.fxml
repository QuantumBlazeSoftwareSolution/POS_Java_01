<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane id="AnchorPane" prefHeight="640.0" prefWidth="800.0" stylesheets="@../../css/adminStyle.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.qb.app.controllers.admin.inventory.Inventory_stock_managementController">
   <children>
      <VBox layoutX="107.0" layoutY="220.0" spacing="20.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <children>
            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="tfItemName" prefHeight="40.0" promptText="Item Name" />
                  <TextField fx:id="tfBarCode" prefHeight="40.0" promptText="Barcode" />
               </children>
            </HBox>
            <TableView fx:id="table" editable="true" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colBatchId" editable="false" maxWidth="140.0" prefWidth="75.0" text="Batch ID" />
                <TableColumn fx:id="colItemName" editable="false" prefWidth="75.0" text="Item Name" />
                  <TableColumn fx:id="colCostPrice" editable="false" maxWidth="160.0" prefWidth="75.0" text="Cost Price" />
                  <TableColumn fx:id="colSalePrice" maxWidth="160.0" prefWidth="75.0" text="Sale Price" />
                  <TableColumn fx:id="colExpireDate" editable="false" maxWidth="160.0" prefWidth="75.0" text="Expire Date" />
                  <TableColumn fx:id="colAction" editable="false" maxWidth="200.0" prefWidth="75.0" text="Action" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
